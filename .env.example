# Copy to .env locally. Never commit secrets.

DATABASE_URL=postgresql+psycopg://marginmind:marginmind@localhost:5432/marginmind

# LLM: gemini = Google Gemini API (free tier, MVP live provider).
# stub = deterministic fallback. Do not integrate Gemini in M0–M10.
LLM_PROVIDER=stub
GEMINI_API_KEY=

# Payments: stub (default, tests) | razorpay (Test Mode only).
# Do not put live/prod keys here. Never commit secrets.
# RAZORPAY_WEBHOOK_SECRET is NOT the same as RAZORPAY_KEY_SECRET.
PAYMENT_PROVIDER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_DISPLAY_NAME=Lumen & Thread

# Opt-in live Test Mode verification (never required for pytest):
# MARGINMIND_LIVE_RAZORPAY=1

